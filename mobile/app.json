        {
          "NSHealthShareUsageDescription": "Step Competition reads your daily step count so it can put you on your competitions' leaderboards.",
          "NSHealthUpdateUsageDescription": false,
          "background": true
        }
      ]
    ],
    "scheme": "stepcompetition",
