{
  "expo": {
    "name": "Pass1",
    "slug": "step-competition",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.heatedmicrowave.stepcompetition",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true,
        "NSLocationWhenInUseUsageDescription": "Pass1 doesn't use your location. The map inside a challenge only shows the mountain or route you're racing on."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#DCE2DF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.heatedmicrowave.stepcompetition"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Pass1 reads your daily step count so it can put you on your competitions' leaderboards.",
          "NSHealthUpdateUsageDescription": "Pass1 only reads your steps. It never writes anything to Apple Health.",
          "background": true
        }
      ],
      "@rnmapbox/maps",
      "expo-notifications"
    ],
    "scheme": "stepcompetition",
    "extra": {
      "supabaseUrl": "https://rzkcrgihokfnyjazjtwh.supabase.co",
      "supabaseKey": "sb_publishable_kvp1jafJOXqE9_1aHFvS-A_hmd30Gbx",
      "eas": {
        "projectId": "37f446d3-68ab-4e01-8e97-3aab84e8db75"
      }
    },
    "owner": "heatedmicrowave",
    "locales": {
      "it": "./locales/it.json",
      "es": "./locales/es.json",
      "ja": "./locales/ja.json"
    }
  }
}
